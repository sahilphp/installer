#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * SahilPHP public entry point.
 *
 * This file only loads Composer and delegates to the framework console. Every
 * command implementation lives in the installed `sahilphp/framework` package,
 * so the application contains no copy of the framework CLI.
 *
 * Usage:
 *   php sahil
 *   php sahil about
 *   php sahil unda:controller UserController
 */

if (PHP_VERSION_ID < 80400) {
    fwrite(STDERR, 'SahilPHP requires PHP 8.4 or higher. You are running '.PHP_VERSION.'.'.PHP_EOL);
    exit(1);
}

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, 'This entry point must be run from the command line.'.PHP_EOL);
    exit(1);
}

$autoload = __DIR__.'/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, 'SahilPHP: vendor/autoload.php is missing. Run `composer install` first.'.PHP_EOL);
    exit(1);
}

require $autoload;

exit((new Sahil\Console\Application(__DIR__))->run(array_values(array_slice($argv, 1))));
