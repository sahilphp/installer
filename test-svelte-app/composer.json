{
    "name": "sahilphp/test-svelte-app",
    "description": "A starter application for building projects with the SahilPHP framework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Idrisa24",
            "email": "idrisajohn19@gmail.com"
        }
    ],
    "homepage": "https://github.com/sahilphp/sahilphp",
    "support": {
        "issues": "https://github.com/sahilphp/sahilphp/issues",
        "source": "https://github.com/sahilphp/sahilphp"
    },
    "keywords": [
        "sahilphp",
        "starter-kit",
        "application",
        "framework"
    ],
    "require": {
        "php": "^8.4",
        "sahilphp/framework": "^1.1",
        "sahilphp/svelte": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php sahil start",
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php sahil key:generate",
            "@php sahil storage:prepare",
            "@php sahil ui:setup"
        ]
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.phpunit.cache",
            "/bin",
            "/composer.lock",
            "/dist",
            "/docs",
            "/node_modules",
            "/package-lock.json",
            "/public/build",
            "/tests",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    }
}