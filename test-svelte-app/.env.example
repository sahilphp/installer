# SahilPHP starter-kit environment
#
# Copy this file to `.env` (gitignored) and change what you need:
#
#   cp .env.example .env
#
# Every value is optional: without `.env` the application boots with the
# defaults shown here. Never commit real credentials. `php sahil
# env:check` lists which of these are set, and `php sahil config:show`
# prints configuration with secrets replaced by [redacted].

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# `php sahil key:generate` writes a 32-byte base64 key here. It protects
# encrypted and signed values; keep it secret and per-installation.
APP_NAME=SahilPHP            # display name used in page titles and navigation
APP_KEY=
APP_ENV=development          # production disables debug output and verbose errors
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_TIMEZONE=UTC
APP_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (optional: boot, routing, views and /health work without it)
# ---------------------------------------------------------------------------
# SQLite is the default and needs no setup: the file is created on first
# connect (database/database.sqlite). Leave DB_DATABASE empty to use it.
# For MySQL or PostgreSQL set DB_DRIVER and fill in the connection details.
DB_DRIVER=sqlite             # sqlite (pdo_sqlite) | mysql (pdo_mysql) | pgsql (pdo_pgsql)
DB_DATABASE=                 # sqlite: file path, empty = database/database.sqlite
DB_HOST=127.0.0.1            # mysql/pgsql only
DB_PORT=3306                 # use 5432 for pgsql
DB_USERNAME=                 # mysql/pgsql only
DB_PASSWORD=                 # mysql/pgsql only
DB_CHARSET=utf8mb4           # mysql only

# Queue connection name (see config/queue.php).
DB_CONNECTION=default

# ---------------------------------------------------------------------------
# Queue and scheduler
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
QUEUE_TABLE=jobs
QUEUE_NAME=default
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=0
QUEUE_TIMEOUT=60
QUEUE_SLEEP=1
FAILED_JOB_TABLE=failed_jobs

SCHEDULE_TIMEZONE=UTC                                        # defaults to APP_TIMEZONE
SCHEDULE_LOCK=file                                           # file | database
SCHEDULE_LOCK_PATH=storage/framework/schedule

# ---------------------------------------------------------------------------
# Firefiber
# ---------------------------------------------------------------------------
# FIREFIBER_HMAC_KEY is optional: when empty, the provider derives the
# server-only Firefiber master key from APP_KEY.
FIREFIBER_HMAC_KEY=
FIREFIBER_ACTION_PATH=/firefiber
FIREFIBER_ASSET_PREFIX=/firefiber/assets
FIREFIBER_SNAPSHOT_EXPIRATION=300
FIREFIBER_STATE_TTL=0

# ---------------------------------------------------------------------------
# Cache and sessions
# ---------------------------------------------------------------------------
CACHE_DRIVER=file            # file | redis | database | memcached | dynamodb

SESSION_DRIVER=file
SESSION_LIFETIME=120         # minutes
SESSION_COOKIE=sahil_session
SESSION_PATH=storage/framework/sessions
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false  # true in production (HTTPS only)
SESSION_SAME_SITE=lax        # lax | strict | none

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=log           # log (development) | array (tests) | smtp (delivery)
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_SECURITY=tls            # tls (STARTTLS) | ssl (implicit TLS) | none (plaintext, dev only)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=hello@example.com  # change to your real sender; empty disables the fallback
MAIL_FROM_NAME=SahilPHP
MAIL_QUEUE=false             # true sends notifications through the queue
MAIL_QUEUE_NAME=emails

# ---------------------------------------------------------------------------
# Assets
# ---------------------------------------------------------------------------
# `.sahil-ui.json` (written by `sahil ui:install`) is authoritative; set
# ASSET_PROFILE only to override it.
ASSET_PROFILE=auto           # auto | tailwind | bootstrap | both | none
ASSET_MODE=auto              # auto | development | production
ASSET_DEV_SERVER=http://127.0.0.1:5173
ASSET_URL=                   # prefix public URLs, e.g. /app or a CDN host
ASSET_VERIFY=true            # production: fail when expected build output is missing

# ---------------------------------------------------------------------------
# File storage and uploads
# ---------------------------------------------------------------------------
STORAGE_DISK=local
STORAGE_PUBLIC_PATH=public/storage
STORAGE_PRIVATE_PATH=storage/uploads/private
STORAGE_PUBLIC_URL=http://localhost:8000/storage
STORAGE_MAX_UPLOAD_SIZE=10485760
STORAGE_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_GUARD=session
AUTH_USERS_TABLE=users
AUTH_USER_MODEL=App\Models\User
AUTH_PASSWORD_DRIVER=bcrypt
AUTH_PASSWORD_COST=12
AUTH_MAX_ATTEMPTS=5
AUTH_REMEMBER_ENABLED=true
AUTH_REMEMBER_DURATION=30    # days
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_PASSWORD_RESET_ENABLED=true

# ---------------------------------------------------------------------------
# HTTP: CORS, rate limiting, request IDs
# ---------------------------------------------------------------------------
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORE=Sahil\Http\RateLimit\ArrayStore
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW=60

REQUEST_ID_HEADER=X-Request-Id
REQUEST_ID_IDEMPOTENCY_HEADER=Idempotency-Key

# Trusted reverse proxies (comma-separated IPs/CIDRs); empty means none.
TRUSTED_PROXIES=

# CSRF exceptions (comma-separated paths).
CSRF_EXCEPT=
