{
    "name": "sahilphp/installer",
    "type": "library",
    "description": "SahilPHP Installer - Creates new SahilPHP projects with Tailwind CSS or Bootstrap 5",
    "license": "MIT",
    "authors": [
        {
            "name": "Idrisa John",
            "email": "idrisajohn19@gmail.com"
        }
    ],
    "keywords": ["sahilphp", "installer", "new project", "tailwind", "bootstrap"],
    "homepage": "https://github.com/sahilphp/installer",
    "support": {
        "issues": "https://github.com/sahilphp/installer/issues",
        "source": "https://github.com/sahilphp/installer"
    },
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0",
        "symfony/filesystem": "^7.2|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "SahilPHP\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SahilPHP\\Installer\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/sahilphp"],
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 -P8 php -l",
        "test": "phpunit --configuration phpunit.xml.dist",
        "analyse": "phpstan analyse --no-progress --level 8",
        "fix-style": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "check-style": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "check": ["@lint", "@test", "@analyse"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
