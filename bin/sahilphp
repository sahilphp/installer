#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * SahilPHP Installer - CLI entry point.
 *
 * Usage:
 *   sahilphp new <name> [options]
 *   sahilphp doctor
 *   sahilphp --help
 */
require_once __DIR__.'/../vendor/autoload.php';

use SahilPHP\Installer\Application as InstallerApplication;
use Symfony\Component\Console\Application;
use Symfony\Component\Debug\Debug;

$isCli = PHP_SAPI === 'cli';

if (!$isCli) {
    fwrite(STDERR, 'This binary must be run from the command line.' . PHP_EOL);
    exit(1);
}

if (getenv('SAHIL_INSTALLER_DEBUG') === '1') {
    Debug::enable();
}

$application = new Application('SahilPHP Installer');
$application->setDefaultCommand('new');
$application->setCatchExceptions(false);

$exitCode = $application->run();

exit($exitCode);