# Files excluded from the distributed package (Composer dist archives).
/docs                    export-ignore
/tests                   export-ignore
/scripts                 export-ignore
/.github                 export-ignore
/.sahil-ui.json          export-ignore
# .sahil/scaffolds must ship: `php sahil unda:auth` reads it from the installed app.
/CHANGELOG.md            export-ignore
/CODE_OF_CONDUCT.md      export-ignore
/CONTRIBUTING.md         export-ignore
/SECURITY.md             export-ignore
/phpunit.xml.dist        export-ignore
/phpstan.neon.dist       export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/bin                     export-ignore
/composer.json.backup    export-ignore
/composer.lock           export-ignore
/dist                    export-ignore
/node_modules            export-ignore
/package-lock.json       export-ignore
/public/build            export-ignore
/.phpunit.cache          export-ignore
/vendor                  export-ignore

# License: starter kit does NOT ship framework LICENSE into user project
LICENSE                export-ignore

# Normalise line endings in the archive.
* text=auto eol=lf
